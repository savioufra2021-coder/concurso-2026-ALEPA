    match /activities/{activityId} {
      allow get: if isValidId(activityId) && (
        (existing().status == 'published' && isSignedIn()) ||
        (isSignedIn() && existing().authorId == request.auth.uid) ||
        isEditor()
      );
      allow list: if (resource.data.status == 'published' && isSignedIn())
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isEditor();
      allow create: if isValidId(activityId)
        && isTeacher()
        && isValidActivity(incoming(), activityId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(activityId)
        && isValidActivity(incoming(), activityId)
        && incoming().activityId == existing().activityId
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isEditor() ||
          (isTeacher() && existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'classId', 'disciplineId', 'campusLevel', 'title', 'instructions',
            'activityType', 'dueDate', 'maxScore', 'questionIds', 'prompts', 'status', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(activityId) && (isAdmin() || (isTeacher() && existing().authorId == request.auth.uid));
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        existing().studentId == request.auth.uid ||
        existing().teacherId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(submissionId)
        && isVerified()
        && isValidSubmission(incoming(), submissionId)
        && incoming().studentId == request.auth.uid
        && incoming().manualScore == 0
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId)
        && isVerified()
        && isValidSubmission(incoming(), submissionId)
        && incoming().submissionId == existing().submissionId
        && incoming().activityId == existing().activityId
        && incoming().classId == existing().classId
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isTeacher() && existing().teacherId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'manualScore', 'finalScore', 'feedback', 'status', 'gradedBy', 'revisionHistory', 'updatedAt'
          ])) ||
          (existing().studentId == request.auth.uid
            && existing().status == 'submitted'
            && incoming().manualScore == existing().manualScore
            && incoming().finalScore == incoming().objectiveScore
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'objectiveAnswers', 'discursiveResponses', 'objectiveScore', 'finalScore', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    match /storageMetadata/{fileId} {
      allow get: if isValidId(fileId) && (isAdmin() || (isSignedIn() && existing().uploadedBy == request.auth.uid));
      allow list: if isAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);
      allow create: if isValidId(fileId)
        && isTeacher()
        && isValidStorageMetadata(incoming(), fileId)
        && incoming().uploadedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(fileId)
        && isValidStorageMetadata(incoming(), fileId)
        && incoming().fileId == existing().fileId
        && incoming().uploadedBy == existing().uploadedBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isTeacher() && existing().uploadedBy == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'linkedMaterialId', 'campusLevel', 'archived', 'version', 'updatedAt'
          ]))
        );
      allow delete: if isValidId(fileId) && isAdmin();
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isVerified()
        && isValidAuditLog(incoming(), logId)
        && incoming().actorId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /academicRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        existing().studentId == request.auth.uid ||
        existing().assignedTeacherId == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.assignedTeacherId == request.auth.uid ||
        isTeacher() ||
        isAdmin()
      );
      allow create: if isValidId(requestId)
        && isVerified()
        && isValidAcademicRequest(incoming(), requestId)
        && incoming().studentId == request.auth.uid
        && incoming().status == 'pendente'
        && incoming().messageCount == 0
        && (!incoming().keys().hasAny(['assignedTeacherId']) || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(requestId)
        && isVerified()
        && isValidAcademicRequest(incoming(), requestId)
        && incoming().requestId == existing().requestId
        && incoming().studentId == existing().studentId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isTeacher()
            && (!existing().keys().hasAny(['assignedTeacherId']) || existing().assignedTeacherId == '' || existing().assignedTeacherId == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'lastMessagePreview', 'lastMessageByRole', 'messageCount', 'updatedAt'
            ])) ||
          (existing().studentId == request.auth.uid
            && incoming().status in ['pendente', 'aguardando_resposta', 'concluida']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'lastMessagePreview', 'lastMessageByRole', 'messageCount', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(requestId) && isAdmin();

      match /messages/{messageId} {
        allow get: if isValidId(requestId) && isValidId(messageId) && isSignedIn() && (
          get(/databases/$(database)/documents/academicRequests/$(requestId)).data.studentId == request.auth.uid ||
          get(/databases/$(database)/documents/academicRequests/$(requestId)).data.assignedTeacherId == request.auth.uid ||
          isTeacher() ||
          isAdmin()
        );
        allow list: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.studentId == request.auth.uid ||
          resource.data.assignedTeacherId == request.auth.uid ||
          isTeacher() ||
          isAdmin()
        );
        allow create: if isValidId(requestId) && isValidId(messageId)
          && isVerified()
          && isValidAcademicRequestMessage(incoming(), messageId, requestId)
          && incoming().senderId == request.auth.uid
          && incoming().studentId == get(/databases/$(database)/documents/academicRequests/$(requestId)).data.studentId
          && incoming().createdAt == request.time
          && (
            (isAdmin() && incoming().senderRole in ['admin', 'dev', 'editor', 'teacher']) ||
            (isTeacher() && !isAdmin()
              && incoming().senderRole in ['teacher', 'editor']
              && (
                !get(/databases/$(database)/documents/academicRequests/$(requestId)).data.keys().hasAny(['assignedTeacherId']) ||
                get(/databases/$(database)/documents/academicRequests/$(requestId)).data.assignedTeacherId == '' ||
                get(/databases/$(database)/documents/academicRequests/$(requestId)).data.assignedTeacherId == request.auth.uid
              )) ||
            (get(/databases/$(database)/documents/academicRequests/$(requestId)).data.studentId == request.auth.uid
              && incoming().senderRole == 'student')
          );
        allow update, delete: if false;
      }
    }
  }
}
